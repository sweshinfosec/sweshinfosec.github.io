---
layout: none
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | jsonify }},"excerpt":{{ post.excerpt | strip_html | strip_newlines | truncatewords: 25 | jsonify }},"date":{{ post.date | date: "%b %-d, %Y" | jsonify }},"categories":{{ post.categories | jsonify }},"tags":{{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
